# Git and local editor
.git
.gitignore
.idea
.vscode
.cursor

# Python virtualenv and caches
venv
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Secrets (inject at runtime via env_file / orchestrator secrets)
.env

# Runtime data (mount as volumes in production)
databases
sync_downloads
raw
*.db
*.db-shm
*.db-wal

# Local downloads and exports
old_files
test_output
exports

# Runtime user uploads — recreated on demand; never bake a developer's copy in.
# (graphify-out/ is deliberately NOT excluded: /documentation serves it.)
uploads

# Unreferenced at runtime; ~10MB of image for nothing.
*.pptx
PM*.xml

# CI / test scaffolding
.github
.ci-data
conftest.py

# Docs assets (optional; keep image smaller)
docs/primenet_workflow/images

# Human / agent markdown — not needed in production containers.
# (In-app /documentation will be empty in the image; use git checkout locally.)
**/*.md
docs/
AGENTS.md
checklist.md
progress.md
*.progress.md

# Agent / misc
agent-transcripts
