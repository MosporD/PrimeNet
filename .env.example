# SQLite only: app users, metadata, and PM KPIs live under databases/*.db

# ── Production (Docker) ─────────────────────────────────────────────────────
# NCM_DATA_ROOT=/data          # set in container; mount a volume at /data
# NCM_CONTAINER=1              # disables Windows live logger; set by Dockerfile
# PRIMENET_HTTP_PORT=8000      # host port mapped in docker-compose.yml
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=600
# NCM_ENABLE_HSTS=1            # when served only over HTTPS

# Flask/session secret (required for stable sessions across restarts)
# FLASK_SECRET_KEY=replace-with-long-random-secret

# Bootstrap admin creation (used only if users table is empty)
# NCM_BOOTSTRAP_ADMIN_USERNAME=admin
# NCM_BOOTSTRAP_ADMIN_EMAIL=admin@company.com
# NCM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
# NCM_DEFAULT_USER_PASSWORD=Zain@1234

# SFTP credentials (keep only in local .env, never in git)
# NOKIA_PM_HOST=10.119.219.77
# NOKIA_PM_PORT=22
# NOKIA_PM_USER=ftpuser
# NOKIA_PM_PASSWORD=
#
# HUAWEI_PM_HOST=10.119.10.104
# HUAWEI_PM_PORT=22
# HUAWEI_PM_USER=tooluser
# HUAWEI_PM_PASSWORD=
#
# METADATA_HOST=192.168.7.207
# METADATA_PORT=22
# METADATA_USER=ftpuser
# METADATA_PASSWORD=

# ── CM Extractor (Nokia NetAct Open API + Huawei U2020 MML) ─────────────────
# Nokia CM Open API (server-side only; HTTP Basic auth — not the PrimeNet app login).
# Use a NetAct user with CM Open API / Configurator read access.
# NOKIA_CM_HOST=login.rc02.netact.zainjo.net
# NOKIA_CM_USER=nemuuser
# NOKIA_CM_PASSWORD=your_netact_cm_api_password
# Optional full API base (overrides host): https://<lbwas-host>/netact/cm/open-api/persistency/v1
# NOKIA_CM_BASE_URL=
# NOKIA_CM_VERIFY_SSL=0
# Full-MO export throttling (avoid NetAct 429 rate limits on large exports)
# NOKIA_CM_MO_BATCH_SIZE=150
# NOKIA_CM_BATCH_DELAY_SEC=0.4
# NOKIA_CM_MAX_RETRIES=8
# NOKIA_CM_RETRY_BASE_DELAY_SEC=2
# Extra MO abbreviations to send via CM Operations bulk export (added to LNREL/LNADJ/LNHOIF).
# CM_BULK_MO_CLASSES=LNHOIF,LNREL,LNADJ
# CM_EXPORT_RETENTION_SEC=604800
# CM_EXPORT_MAX_PER_USER=50
#
# Session lifetime (hours) for login session_token cookie (default 2).
# SESSION_LIFETIME_HOURS=2
#
# Nokia FM Operations REST API (Keycloak/OAuth; used by Fault Management).
# Reuses NOKIA_CM_HOST, NOKIA_CM_USER, and NOKIA_CM_PASSWORD above.
# Create an FM API client on the fmapi-service node with:
# /opt/oss/fmapi-service/tools/api_client.sh --create-client <client_id>
# Optional overrides if FM is exposed on a different LB WAS URL than NOKIA_CM_HOST:
# NOKIA_FM_BASE_URL=https://<lbwas-host>/api/fm/v1
# NOKIA_FM_TOKEN_URL=https://<lbwas-host>:10448/auth/realms/netact-auth/protocol/openid-connect/token
# NOKIA_FM_CLIENT_ID=primenet-fm
# Optional; set only when the Keycloak client has a secret.
# NOKIA_FM_CLIENT_SECRET=
# NOKIA_FM_VERIFY_SSL=0
# NOKIA_FM_TIMEOUT=180
#
# RNC/BSC bulk export: CM Operations Import_Export writes RAML/XML on the NetAct OMC.
# PrimeNet pulls the file via SFTP (OMC host, not the CM REST login hostname).
# If unset, falls back to NOKIA_PM_HOST / NOKIA_PM_USER / NOKIA_PM_PASSWORD above.
# NOKIA_CM_SSH_HOST=10.119.219.77
# NOKIA_CM_SSH_PORT=22
# NOKIA_CM_SSH_USER=your_omc_sftp_user
# NOKIA_CM_SSH_PASSWORD=your_omc_sftp_password
# NOKIA_CM_EXPORT_DIR=/d/oss/global/var/racops/export
# Optional extra export folders (comma-separated) if NetAct writes elsewhere:
# NOKIA_CM_EXPORT_DIR_EXTRA=/var/opt/oss/global/racops/export
# Full RNC/BSC bulk export waits (Import_Export on NetAct can take 10–40+ min):
# NOKIA_CM_BULK_OPERATION_TIMEOUT_SEC=3600
# NOKIA_CM_EXPORT_FILE_WAIT_SEC=600
# NOKIA_CM_SSH_TIMEOUT=60
#
# HUAWEI_CM_HOST=10.119.10.4
# HUAWEI_CM_API_STYLE=wireless
# wireless (RAN): 31943 (web/SSO) or 31127 (northbound) — cn (core): 31127 only
# HUAWEI_CM_PORT=31943
# HUAWEI_CM_USER=
# HUAWEI_CM_PASSWORD=
# HUAWEI_CM_VERIFY_SSL=0
# CN MML script tasks only:
# HUAWEI_CM_CLIENT_IP=10.x.x.x
# HUAWEI_CM_SCRIPT_BASE_URL=https://your-server/scripts/
#
# Huawei FM faults use the same northbound host/user as Huawei CM.
# The user must have Fault Supervision Management Open API read access.
#
# Huawei CM Extractor UI/API (all logged-in users). Set false/0/off to hide the tab
# in production until the workflow is ready; admins still need CM_HUAWEI_ENABLED=true.
# CM_HUAWEI_ENABLED=true
#
# CM Extractor scheduled jobs dispatcher (runs due jobs every minute).
# NCM_DISABLE_CM_EXTRACTOR_SCHEDULER=0
# Comma-separated usernames allowed to run Nokia edited-Excel reimport actions.
# CM_WRITE_ALLOWED_USERS=malek.mohammad
# Nokia edited-Excel reimport safety/configuration.
# NOKIA_CM_REIMPORT_MAX_CHANGES=100
# NOKIA_CM_REIMPORT_OPERATION_NAME=Import_Export
# NOKIA_CM_REIMPORT_OPERATION_MODE=actualImport
# NOKIA_CM_REIMPORT_REMOTE_DIR=/d/oss/global/var/racops/import
#
# ── Nokia Load Balancing (Network Balance throughput share) ─────────────────
# Windows dev: read CSVs directly from the UNC share (default when unset on Windows).
# NETWORK_BALANCE_PATH=\\RNO-WAN\Network Balance
#
# Linux / Docker production: auto-mount SMB at container start (recommended).
# PrimeNet mounts //HOST/SHARE then ingests CSVs into SQLite daily.
# NETWORK_BALANCE_SMB_ENABLED=1
# NETWORK_BALANCE_SMB_HOST=192.168.7.210
# NETWORK_BALANCE_SMB_SHARE=Network Balance
# NETWORK_BALANCE_SMB_USER=Malek.Mohammad
# NETWORK_BALANCE_SMB_PASSWORD=
# NETWORK_BALANCE_SMB_DOMAIN=NT
# NETWORK_BALANCE_SMB_MOUNT=/network-balance
# NETWORK_BALANCE_PATH=/network-balance
#
# Alternative: mount on the Linux host (/etc/fstab) and bind-mount into Docker —
# set NETWORK_BALANCE_SMB_ENABLED=0 and NETWORK_BALANCE_PATH=/network-balance
# plus docker-compose volume: /mnt/network-balance:/network-balance:ro
#
# Optional second CSV source for backfill ingest.
# NETWORK_BALANCE_ARCHIVE_PATH=/data/network_balance_archive
# NETWORK_BALANCE_VENDOR=Nokia
# NETWORK_BALANCE_PREFER_SQLITE=1
# NETWORK_BALANCE_INGEST_LOOKBACK_DAYS=14
# NETWORK_BALANCE_INGEST_HOUR_OFFSET=1
# NCM_DISABLE_NETWORK_BALANCE_INGEST=0
#
# ── Performance Analytics (Huawei MAE PM Open API §5.4) ─────────────────────
# Uses the same northbound credentials as CM (port 31127, NBI user — not web SSO).
# HUAWEI_PM_API_TIMEOUT=300
# HUAWEI_PM_API_POLL_SEC=3
# HUAWEI_PM_API_POLL_TIMEOUT_SEC=900
# HUAWEI_PM_API_PAGE_LIMIT=5000
# HUAWEI_PM_API_DELETE_TASK=1

# ── PM hourly ingest (Nokia + Huawei, Excel/CSV exports → SQLite) ────────────
# full (default) = delete all rows in each RAT table before each scheduled ingest.
# incremental = keep existing rows; only upsert (cell_name + timestamp).
# PM_SYNC_MODE=incremental
#
# After ingest, delete PM rows older than N days (default 9; set to 0 to disable).
# PM_RETENTION_DAYS=14
# DAILY_RETENTION_DAYS=120
# Daily tables: append history (true) vs replace whole table each run (false).
# RAW_LOADER_DAILY_INCREMENTAL=1
#
# SQLite batch size for INSERT OR REPLACE (optional tuning).
# PM_INSERT_BATCH_SIZE=2500

# Resource limits — keep web UI responsive during pipeline ingest and heavy PM queries.
# PM_INGEST_PARALLEL_WORKERS=2          # parallel RAT writers (default 2, was 5)
# PIPELINE_MAX_PARALLEL_LOADERS=2       # parallel folder loads in raw→DB script
# PIPELINE_CSV_CHUNK_SIZE=50000         # pandas chunk size during CSV load
# HEAVY_QUERY_MAX_CONCURRENT=2          # max concurrent PM table/export queries
# HEAVY_QUERY_SLOT_TIMEOUT_SEC=15       # wait for slot (0 = immediate HTTP 503)
# PM_EXPORT_MAX_ROWS=200000
# PM_CHARTS_MAX_ROWS=15000
# SQLITE_PM_CACHE_SIZE_KB=20000         # SQLite page cache for PM reads (0=default)
# SQLITE_PM_MMAP_SIZE_MB=64             # memory-mapped I/O cap for PM reads (0=off)
#
# Adaptive scaling (enabled by default): ceilings above shrink when free RAM is low.
# RESOURCE_ADAPTIVE=1
# RESOURCE_MIN_FREE_MB=2048             # reserve for web UI; defer pipeline below this
# RESOURCE_LOW_MEMORY_MB=4096           # scale concurrency toward 1 below this
# RESOURCE_HIGH_MEMORY_MB=18432         # use full env ceilings above this (18 GB)
# SCHEDULER_MAX_RSS_MB=6144             # defer new pipeline/precalc when scheduler RSS exceeds this

# Raw loader: ingest newest CSV per RAT; delete all raw files after successful load (default on).
# RAW_LOADER_LATEST_ONLY=1
# RAW_DELETE_ALL_AFTER_LOAD=1
# RAW_PRUNE_AFTER_LOAD=1
# RAW_KEEP_FILES_PER_TECH=1
# RAW_PULL_AUTO_LOAD=1
# RAW_PULL_CLEAR_BEFORE=1
# RAW_PULL_PRUNE_AFTER=1
#
# Scheduled pipeline: hourly pull+load interval (hours) and daily run hour (24h clock).
# RAW_PULL_INTERVAL_HOURS=1
# DAILY_PULL_HOUR=7
# WATCH_POLL_INTERVAL_SEC=1800
# WATCH_VERIFY_DB_INGEST=1
# WATCH_ALWAYS_RUN=0

# Scheduler: hourly + daily ingest always on; watcher verifies DB and fills gaps.
# NCM_DISABLE_PULL_WATCHER=0
# NCM_DISABLE_SCHEDULER=0
#
# SON ML nightly job (after Network Health precalc). Flask never imports torch.
# SON_DISABLE_ML=0
# SON_DISABLE_TORCH=0

# ── Parameter Dictionary AI (optional natural-language summaries) ───────────────
# Without OPENAI_API_KEY the assistant still works using dictionary lookup only.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Operator activation (local password — creator / sole operator) ───────────
# 1) Do NOT set NCM_LICENSE_SERVER_URL unless you use the remote license service.
# 2) Run once: python scripts/set_activation_password.py
# 3) Unlock at /activation or: python scripts/set_activation_password.py --unlock
# Secrets file (gitignored): core/activation_secrets_local.py — back up privately.
# NCM_ACTIVATION_PERIOD_DAYS=180
#
# ── Remote license service (optional; Excess/license_service/ if archived) ───
# NCM_LICENSE_SERVER_URL=http://your-license-host:5055
# NCM_LICENSE_PUBLIC_KEY_PATH=C:\path\to\public.pem
# NCM_LICENSE_INSTANCE_ID=primenet-prod-1
# NCM_LICENSE_ONLINE_VERIFY_HOURS=24
# NCM_LICENSE_OFFLINE_GRACE_HOURS=72
#
# Dev only — disables the gate entirely:
# NCM_SKIP_ACTIVATION=1
