#=============================================================================
#PrimeNet / NexusCore — environment template
#Copy to `.env` and fill secrets. Never commit `.env`.
#Blank = use code default (or “not configured”).
#=============================================================================

#── Database (SQLite by default) ─────────────────────────────────────────────
#Leave Postgres URLs unset on a laptop unless you run Postgres + migrate.

#Phase 1: Postgres for app users/sessions only (not PM/CM data).
#Then run: python scripts/migrate_ncm_users_to_postgres.py
NCM_APP_DATABASE_URL=postgresql://primenet:change-me@127.0.0.1:5432/primenet

#Phases 2–4: same Postgres server for app + domain schemas.
NCM_DATABASE_URL=postgresql://primenet:change-me@127.0.0.1:5432/primenet

#Which schemas to migrate (comma-separated). Nokia/Huawei PM names collide → keep separate.
#Then run: python scripts/migrate_all_sqlite_to_postgres.py
NCM_PG_DOMAINS=app,metadata,neighbors,groups,balance,pm

#Optional local Postgres via: docker compose --profile app-db up -d postgres
#Required by that compose profile (no default).
NCM_APP_POSTGRES_PASSWORD=

#Database name published on 127.0.0.1 only.
NCM_APP_POSTGRES_DB=primenet

#DB role name.
NCM_APP_POSTGRES_USER=primenet

#Host port mapped to Postgres.
NCM_APP_POSTGRES_PORT=5432

#── Production (Docker container) ────────────────────────────────────────────

#Writable data dir inside the container (mount a volume here).
NCM_DATA_ROOT=/data

#Set by Dockerfile; disables Windows live logger.
NCM_CONTAINER=1

#Number of Gunicorn worker processes.
GUNICORN_WORKERS=2

#Threads per worker.
GUNICORN_THREADS=4

#Request timeout seconds (raise for long CM/PM jobs).
GUNICORN_TIMEOUT=600

#Send Strict-Transport-Security when the site is HTTPS-only.
NCM_ENABLE_HSTS=1

#── Flask / session crypto ───────────────────────────────────────────────────

#REQUIRED for stable sessions + decrypting saved vendor credentials (U2020 / MantaRay).
#If empty, each process invents a random key → sessions die on restart and saved passwords stop decrypting.
#Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

#Optional override for NexusCore only (cookies already isolated by name).
FLASK_SECRET_KEY_NEXUSCORE=

#Optional override for PrimeNet only.
FLASK_SECRET_KEY_PRIMENET=

#Optional override for NexPulse only.
FLASK_SECRET_KEY_NEXPULSE=

#── NexusCore platform / access (how browsers reach the three portals) ───────
#Two supported layouts — do not mix “pinned public URL” with “from request”:
#
#A) Docker — one public port, nginx path-routes /portals /dashboard /etc.
#   sudo docker compose up -d  →  http://<server>/portals
#   Leave *_PUBLIC_URL empty; FROM_REQUEST=1; cookie domain empty.
#
#B) Local suite — python app.py: ONE process, ONE listen port (same paths as Docker).
#   Listens only on PROXY_HTTP_PORT (falls back to 8080 if :80 blocked).
#   No :8000/:8001/:8002. app.py forces FROM_REQUEST=1 for same-origin redirects.

#Public port for python app.py (and Docker nginx publish). Default 80.
PROXY_HTTP_PORT=80

#1 = build redirect base from the browser Host (and X-Forwarded-*).
#Use with Docker/nginx or app.py. Prefer this over pinning URLs.
NEXUS_PUBLIC_URL_FROM_REQUEST=1

#Optional fixed shared origin for all portals (e.g. http://RAN-PrimNet-SRV).
#When set, wins over FROM_REQUEST. Leave empty for Docker / local suite.
NEXUS_PUBLIC_URL=

#Lobby public URL when NOT sharing one origin (rare; multi-host).
#Ignored when NEXUS_PUBLIC_URL or FROM_REQUEST applies. Default http://localhost:8000.
NEXUSCORE_PUBLIC_URL=

#Engineering Portal public URL when not sharing one origin.
#Also used as activation unlock redirect target. Default http://localhost:8001.
PRIMENET_PUBLIC_URL=

#Marketing Portal public URL when not sharing one origin. Default http://localhost:8002.
NEXPULSE_PUBLIC_URL=

#Share SSO cookie across subdomains (e.g. .zain.com).
#Leave empty for localhost / single-host Docker path proxy.
NEXUS_COOKIE_DOMAIN=

#Cookie name shared by all three portals (SSO).
NEXUS_SESSION_COOKIE=nexus_session

#1 = one unlock gates all three processes (local/test).
#0 = this process skips the shared gate (transition / special deploys).
NCM_SHARED_ACTIVATION=1

#0 = SSO only via NexusCore lobby (production default).
#1 = allow username/password login on PrimeNet/NexPulse directly.
NCM_ALLOW_LOCAL_LOGIN=0

#NexPulse → PrimeNet HTTP base (network-aware targeting).
#Docker service DNS default. Local suite (app.py) overrides to http://127.0.0.1:<PROXY_HTTP_PORT>.
NEXUS_PRIMENET_API_URL=http://primenet:8001

#Shared secret for NexPulse ↔ PrimeNet portal API calls.
#Must match on both sides; replace before production.
NEXUS_PORTAL_API_TOKEN=replace-with-shared-secret

#Flask listen port when you start NexusCore alone (not via app.py). Default 8000.
NEXUSCORE_PORT=8000

#Flask listen port when you start PrimeNet alone (not via app.py). Default 8001.
PRIMENET_PORT=8001

#Flask listen port when you start NexPulse alone (not via app.py). Default 8002.
NEXPULSE_PORT=8002

#── Drive Test Viewer ────────────────────────────────────────────────────────

#Nemo Analyze install dir (FF2.html / object_mapper.xml).
#Defaults to the Windows install path; set explicitly on Linux/containers.
NEMO_ANALYZE_DIR=/opt/nemo-analyze

#── Bootstrap admin (only when PrimeNet users table is empty) ────────────────

#First admin username created on empty DB.
NCM_BOOTSTRAP_ADMIN_USERNAME=admin

#First admin email.
NCM_BOOTSTRAP_ADMIN_EMAIL=admin@company.com

#First admin password (use a strong one).
NCM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

#Default password assigned to newly provisioned users.
NCM_DEFAULT_USER_PASSWORD=Zain@1234

#── SFTP — Nokia / Huawei PM Excel + metadata (keep secrets in local .env) ───

#Nokia NetAct SFTP host for Excel KPI pulls.
NOKIA_PM_HOST=10.119.219.77

#SFTP port (usually 22).
NOKIA_PM_PORT=22

#SFTP username.
NOKIA_PM_USER=ftpuser

#SFTP password.
NOKIA_PM_PASSWORD=

#Performance Explorer Plus — Nokia NBI raw .gz (separate from Excel KPI SFTP)

#FTP/SFTP user for raw counter files.
NOKIA_PM_FTP_USER=ftpuser

#Primary raw-PM host.
NOKIA_PM_FTP_PRIMARY_HOST=10.119.219.24

#Password for primary host.
NOKIA_PM_FTP_PRIMARY_PASSWORD=

#Failover raw-PM host.
NOKIA_PM_FTP_BACKUP_HOST=10.119.219.25

#Password for backup host.
NOKIA_PM_FTP_BACKUP_PASSWORD=

#Remote path for RC02 VM14 raw PM.
NOKIA_PM_FTP_PATH_14=/var/opt/oss/global/ftirpuser/pm/rc02vm14/raw/

#Remote path for RC02 VM15 raw PM.
NOKIA_PM_FTP_PATH_15=/var/opt/oss/global/ftirpuser/pm/rc02vm15/raw/

#Postgres URL for PM Plus continuous ingest.
PM_PLUS_DATABASE_URL=postgresql://primenet:change-me@127.0.0.1:5432/primenet

#Postgres schema name for PM Plus tables.
PM_PLUS_SCHEMA=pm_plus

#Parallel download threads for raw files.
PM_PLUS_DOWNLOAD_WORKERS=8

#Parallel ingest threads into Postgres.
PM_PLUS_INGEST_WORKERS=8

#How often the worker polls for new files (seconds).
PM_PLUS_POLL_INTERVAL_SEC=30

#Huawei U2020/MAE SFTP host for Excel/CSV KPI pulls.
HUAWEI_PM_HOST=10.119.10.104

#SFTP port.
HUAWEI_PM_PORT=22

#SFTP username.
HUAWEI_PM_USER=tooluser

#SFTP password.
HUAWEI_PM_PASSWORD=

#SFTP host for cell/site metadata files.
METADATA_HOST=192.168.7.207

#SFTP port.
METADATA_PORT=22

#SFTP username.
METADATA_USER=ftpuser

#SFTP password.
METADATA_PASSWORD=

#── CM Extractor (Nokia NetAct Open API + Huawei U2020 MML) ─────────────────
#Nokia CM Open API — server-side HTTP Basic (NetAct user with CM/Configurator read).
#Not the PrimeNet app login.

#NetAct login / LB hostname for CM Open API.
NOKIA_CM_HOST=login.rc02.netact.zainjo.net

#NetAct CM API username.
NOKIA_CM_USER=nemuuser

#NetAct CM API password.
NOKIA_CM_PASSWORD=your_netact_cm_api_password

#Full API base; if set, overrides host-built URL.
#Example: https://<lbwas-host>/netact/cm/open-api/persistency/v1
NOKIA_CM_BASE_URL=

#0 = skip TLS cert verify (lab/self-signed). 1 = verify.
NOKIA_CM_VERIFY_SSL=0

#MOs per request on full-MO export (lower = fewer 429s).
NOKIA_CM_MO_BATCH_SIZE=150

#Pause between MO batches (seconds).
NOKIA_CM_BATCH_DELAY_SEC=0.4

#Retries on transient NetAct failures / 429.
NOKIA_CM_MAX_RETRIES=8

#Base backoff delay before retries (seconds).
NOKIA_CM_RETRY_BASE_DELAY_SEC=2

#Extra MO abbreviations for CM Operations bulk export (added to LNREL/LNADJ/LNHOIF).
CM_BULK_MO_CLASSES=LNHOIF,LNREL,LNADJ

#How long export files are kept on disk (default 7 days = 604800 sec).
CM_EXPORT_RETENTION_SEC=604800

#Max retained exports per user.
CM_EXPORT_MAX_PER_USER=50

#Login session cookie lifetime in hours (default 2).
SESSION_LIFETIME_HOURS=2

#Nokia FM Operations REST (Keycloak/OAuth) — Fault Management module.
#Reuses NOKIA_CM_HOST / NOKIA_CM_USER / NOKIA_CM_PASSWORD unless overridden.
#Create client on fmapi-service:
#  /opt/oss/fmapi-service/tools/api_client.sh --create-client <client_id>

#FM API base if not on the same LB as CM.
NOKIA_FM_BASE_URL=https://<lbwas-host>/api/fm/v1

#Keycloak token endpoint for FM client credentials.
NOKIA_FM_TOKEN_URL=https://<lbwas-host>:10448/auth/realms/netact-auth/protocol/openid-connect/token

#OAuth client id registered for PrimeNet FM.
NOKIA_FM_CLIENT_ID=primenet-fm

#Set only if the Keycloak client has a secret.
NOKIA_FM_CLIENT_SECRET=

#0 = skip TLS verify for FM calls.
NOKIA_FM_VERIFY_SSL=0

#HTTP timeout seconds for FM requests.
NOKIA_FM_TIMEOUT=180

#RNC/BSC bulk export — CM Operations Import_Export writes RAML/XML on the OMC;
#PrimeNet pulls via SFTP (OMC host, not the CM REST login hostname).
#If unset, falls back to NOKIA_PM_HOST / USER / PASSWORD.

#OMC SFTP host for export files.
NOKIA_CM_SSH_HOST=10.119.219.77

#OMC SFTP port.
NOKIA_CM_SSH_PORT=22

#OMC SFTP username.
NOKIA_CM_SSH_USER=your_omc_sftp_user

#OMC SFTP password.
NOKIA_CM_SSH_PASSWORD=your_omc_sftp_password

#Primary remote folder where Import_Export writes files.
NOKIA_CM_EXPORT_DIR=/d/oss/global/var/racops/export

#Extra folders to search (comma-separated).
NOKIA_CM_EXPORT_DIR_EXTRA=/var/opt/oss/global/racops/export

#Max wait for Import_Export job (can be 10–40+ min).
NOKIA_CM_BULK_OPERATION_TIMEOUT_SEC=3600

#Max wait for the export file to appear on SFTP (seconds).
NOKIA_CM_EXPORT_FILE_WAIT_SEC=600

#SSH/SFTP connect timeout seconds.
NOKIA_CM_SSH_TIMEOUT=60

#Huawei CM — U2020/MAE northbound / wireless MML.

#U2020 host for CM MML / Open API.
HUAWEI_CM_HOST=10.119.10.4

#wireless (RAN) or cn (core).
HUAWEI_CM_API_STYLE=wireless

#wireless: 31943 (web/SSO) or 31127 (northbound); cn: 31127 only.
HUAWEI_CM_PORT=31943

#U2020 CM username.
HUAWEI_CM_USER=

#U2020 CM password.
HUAWEI_CM_PASSWORD=

#0 = skip TLS verify.
HUAWEI_CM_VERIFY_SSL=0

#CN MML script tasks only: client IP registered on U2020.
HUAWEI_CM_CLIENT_IP=10.x.x.x

#CN MML: base URL where script files are served.
HUAWEI_CM_SCRIPT_BASE_URL=https://your-server/scripts/

#Huawei FM faults use the same northbound host/user as Huawei CM.
#That user needs Fault Supervision Management Open API read access.

#Show Huawei CM Extractor tab/API for all users.
#false/0/off hides it until ready; admins still need this true to use it.
CM_HUAWEI_ENABLED=true

#1 = do not run due CM scheduled jobs each minute.
NCM_DISABLE_CM_EXTRACTOR_SCHEDULER=0

#Usernames allowed to run Nokia edited-Excel reimport (comma-separated).
CM_WRITE_ALLOWED_USERS=malek.mohammad

#Safety cap on rows changed in one reimport.
NOKIA_CM_REIMPORT_MAX_CHANGES=100

#NetAct operation name for reimport.
NOKIA_CM_REIMPORT_OPERATION_NAME=Import_Export

#NetAct mode (e.g. actualImport).
NOKIA_CM_REIMPORT_OPERATION_MODE=actualImport

#OMC folder where reimport plans are uploaded.
NOKIA_CM_REIMPORT_REMOTE_DIR=/d/oss/global/var/racops/import

#── Nokia Load Balancing (Network Balance throughput share) ─────────────────

#Folder of balance CSVs.
#Windows default when unset: \\RNO-WAN\Network Balance
#Linux/Docker after SMB mount: /network-balance
NETWORK_BALANCE_PATH=\\RNO-WAN\Network Balance

#Linux / Docker: auto-mount SMB at container start (recommended in prod).
#Alternative: host fstab mount + docker volume, then SMB_ENABLED=0 and PATH=/network-balance.

#1 = mount share at start; 0 = use pre-mounted path only.
NETWORK_BALANCE_SMB_ENABLED=1

#SMB server IP/hostname.
NETWORK_BALANCE_SMB_HOST=192.168.7.210

#Share name (not the full UNC).
NETWORK_BALANCE_SMB_SHARE=Network Balance

#SMB username.
NETWORK_BALANCE_SMB_USER=Malek.Mohammad

#SMB password.
NETWORK_BALANCE_SMB_PASSWORD=

#Windows/AD domain for SMB auth.
NETWORK_BALANCE_SMB_DOMAIN=NT

#Local mount point inside the container/host.
NETWORK_BALANCE_SMB_MOUNT=/network-balance

#Optional second CSV root for backfill ingest.
NETWORK_BALANCE_ARCHIVE_PATH=/data/network_balance_archive

#Vendor tag stored with ingested rows (usually Nokia).
NETWORK_BALANCE_VENDOR=Nokia

#1 = serve UI from SQLite after ingest instead of re-reading CSVs.
NETWORK_BALANCE_PREFER_SQLITE=1

#How many past days to (re)ingest on each run.
NETWORK_BALANCE_INGEST_LOOKBACK_DAYS=14

#Hour offset applied when aligning file timestamps.
NETWORK_BALANCE_INGEST_HOUR_OFFSET=1

#1 = skip scheduled Network Balance ingest.
NCM_DISABLE_NETWORK_BALANCE_INGEST=0

#── Adjacency GIS (2G NCL snapshots) ─────────────────────────────────────────

#Nokia BTS/TRX/ADCE daily ingest hour (24h, default 4).
ADJACENCY_GIS_CRON_HOUR=4

#Nokia ingest minute (default 30 → 04:30).
ADJACENCY_GIS_CRON_MINUTE=30

#Huawei GTRX/G2GNCELL ingest hour (default 4).
ADJACENCY_GIS_HUAWEI_CRON_HOUR=4

#Huawei ingest minute (default 45 → 04:45).
ADJACENCY_GIS_HUAWEI_CRON_MINUTE=45

#1 = skip Nokia Adjacency GIS scheduled ingest.
NCM_DISABLE_ADJACENCY_GIS_INGEST=0

#1 = skip Huawei Adjacency GIS ingest.
NCM_DISABLE_ADJACENCY_GIS_HUAWEI_INGEST=0

#── Performance Analytics (Huawei MAE PM Open API §5.4) ──────────────────────
#Uses same northbound credentials as CM (port 31127, NBI user — not web SSO).

#HTTP timeout for creating/starting PM tasks.
HUAWEI_PM_API_TIMEOUT=300

#Seconds between task-status polls.
HUAWEI_PM_API_POLL_SEC=3

#Max wait for a PM task to finish (seconds).
HUAWEI_PM_API_POLL_TIMEOUT_SEC=900

#Max rows per page when fetching results.
HUAWEI_PM_API_PAGE_LIMIT=5000

#1 = delete remote PM task after download.
HUAWEI_PM_API_DELETE_TASK=1

#── PM hourly ingest (Nokia + Huawei Excel/CSV → SQLite) ─────────────────────

#Sync “reset” behaviour. PM pull/ingest, metadata pull and group ingest have been
#parked since 2026-07-06. Leave unset to keep parked; set 0 to run real paths again.
NCM_SYNC_RESET_MODE=0

#full = wipe each RAT table before ingest; incremental = upsert only.
PM_SYNC_MODE=incremental

#Delete hourly PM rows older than N days (0 = keep forever; default 9).
PM_RETENTION_DAYS=14

#Retention for daily aggregate tables.
DAILY_RETENTION_DAYS=120

#1 = append daily history; 0 = replace whole daily table each run.
RAW_LOADER_DAILY_INCREMENTAL=1

#SQLite INSERT OR REPLACE batch size (tuning).
PM_INSERT_BATCH_SIZE=2500

#Resource limits — keep the web UI responsive during ingest / heavy PM queries.

#Parallel RAT writers during PM ingest (default 2).
PM_INGEST_PARALLEL_WORKERS=2

#Parallel folder loads in raw→DB.
PIPELINE_MAX_PARALLEL_LOADERS=2

#Pandas rows per chunk when loading CSV.
PIPELINE_CSV_CHUNK_SIZE=50000

#Max simultaneous heavy PM table/export queries.
HEAVY_QUERY_MAX_CONCURRENT=2

#Wait for a query slot; 0 = fail immediately with HTTP 503.
HEAVY_QUERY_SLOT_TIMEOUT_SEC=15

#Hard cap on rows returned by PM export APIs.
PM_EXPORT_MAX_ROWS=200000

#Hard cap on rows fed into PM chart endpoints.
PM_CHARTS_MAX_ROWS=15000

#SQLite page cache for PM reads (0 = SQLite default).
SQLITE_PM_CACHE_SIZE_KB=20000

#Memory-mapped I/O cap for PM reads (0 = off).
SQLITE_PM_MMAP_SIZE_MB=64

#Adaptive scaling — ceilings above shrink when free RAM is low (on by default).

#1 = enable adaptive concurrency; 0 = always use fixed ceilings.
RESOURCE_ADAPTIVE=1

#Reserve this much free RAM for the web UI; defer pipeline below it.
RESOURCE_MIN_FREE_MB=2048

#Below this free RAM, scale concurrency toward 1.
RESOURCE_LOW_MEMORY_MB=4096

#Above this free RAM, use full env ceilings (e.g. 18 GB).
RESOURCE_HIGH_MEMORY_MB=18432

#Defer new pipeline/precalc when scheduler process RSS exceeds this.
SCHEDULER_MAX_RSS_MB=6144

#Raw loader behaviour after SFTP pull.

#1 = ingest newest CSV per RAT only.
RAW_LOADER_LATEST_ONLY=1

#1 = delete all raw files after a successful load.
RAW_DELETE_ALL_AFTER_LOAD=1

#1 = prune old raw files after load (see KEEP below).
RAW_PRUNE_AFTER_LOAD=1

#How many raw files to keep per technology when pruning.
RAW_KEEP_FILES_PER_TECH=1

#1 = automatically load into DB after each pull.
RAW_PULL_AUTO_LOAD=1

#1 = clear raw staging before a new pull.
RAW_PULL_CLEAR_BEFORE=1

#1 = prune remote/local pull artefacts after pull.
RAW_PULL_PRUNE_AFTER=1

#Scheduled pipeline timing.

#Hours between hourly pull+load runs.
RAW_PULL_INTERVAL_HOURS=1

#Hour (0–23) for the daily pull/load job.
DAILY_PULL_HOUR=7

#Pull-watcher poll interval (gap fill / verify), seconds.
WATCH_POLL_INTERVAL_SEC=1800

#1 = watcher checks DB and fills missing hours.
WATCH_VERIFY_DB_INGEST=1

#1 = watcher runs even when nothing looks due.
WATCH_ALWAYS_RUN=0

#Master kill switch for PM/sync/PM-Plus pipelines.
#0 = laptop-safe (no SFTP fill / disk blow-up). 1 = production / server.
#Scheduler entrypoint defaults to 1 if unset there.
NCM_ENABLE_ETL=0

#1 = disable the gap-fill pull watcher only.
NCM_DISABLE_PULL_WATCHER=0

#1 = disable the whole APScheduler (all cron jobs).
NCM_DISABLE_SCHEDULER=0

#Optimization Cases morning digest (Teams/Slack incoming webhook).

#Incoming webhook URL for the digest message.
CASES_DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...

#Public PrimeNet base URL embedded in digest links.
CASES_DIGEST_BASE_URL=https://your-primenet-host

#1 = log digest payload without posting to the webhook.
CASES_DIGEST_DRY_RUN=1

#SON ML nightly job (after Network Health precalc). Flask never imports torch.

#1 = skip SON ML job entirely.
SON_DISABLE_ML=0

#1 = skip torch-dependent paths only.
SON_DISABLE_TORCH=0

#── Parameter Dictionary AI (optional NL summaries) ──────────────────────────
#Without OPENAI_API_KEY the assistant still works via dictionary lookup only.

#OpenAI (or compatible) API key.
OPENAI_API_KEY=sk-...

#API base URL (change for Azure/compatible proxies).
OPENAI_BASE_URL=https://api.openai.com/v1

#Chat model id for Parameter Dictionary summaries.
AI_MODEL=gpt-4o-mini

#── Operator activation (local password — creator / sole operator) ───────────
#1) Do NOT set NCM_LICENSE_SERVER_URL unless you use the remote license service.
#2) Run once: python scripts/set_activation_password.py
#3) Unlock at /activation or: python scripts/set_activation_password.py --unlock
#Secrets file (gitignored): core/activation_secrets_local.py — back up privately.

#How many days an unlock stays valid.
NCM_ACTIVATION_PERIOD_DAYS=180

#Remote license service (optional; Excess/license_service/ if archived).

#Base URL of the remote license service.
NCM_LICENSE_SERVER_URL=http://your-license-host:5055

#Path to PEM public key for license verification.
NCM_LICENSE_PUBLIC_KEY_PATH=C:\path\to\public.pem

#Stable id for this deployment instance.
NCM_LICENSE_INSTANCE_ID=primenet-prod-1

#How often to re-check online (hours).
NCM_LICENSE_ONLINE_VERIFY_HOURS=24

#Allowed offline window after last verify (hours).
NCM_LICENSE_OFFLINE_GRACE_HOURS=72

#DEV ONLY: 1 = disable the activation gate entirely.
NCM_SKIP_ACTIVATION=1

#── NexPulse — Marketing Portal (nexpulse_app.py) ────────────────────────────
#Users/sessions: shared PrimeNet ncm_users.db + nexus_session cookie (SSO above).
#Marketing domain data stays in its own DB.

#Path to marketing domain SQLite (campaigns/offers/…).
#Default: data/portals/marketing/marketing.db
NEXUS_MARKETING_DB=C:\path\to\marketing.db

#Root for portal/platform data dirs (also falls back from NCM_DATA_ROOT).
NEXUS_DATA_ROOT=C:\path\to\nexuscore-data

#Phone-number canonicalisation for consent / DNC matching.
#Without this, 0791234567 and 962791234567 are stored as different subscribers
#and a block on one will NOT stop a send to the other. Set before loading consent/DNC.

#Country calling code (Jordan = 962).
NEXUS_MARKETING_MSISDN_CC=962

#National trunk prefix stripped from local numbers (default 0).
NEXUS_MARKETING_MSISDN_TRUNK=0

#Upstream data sources (none wired yet — UI shows “not connected” until set).
#Network-aware targeting uses NEXUS_PRIMENET_API_URL + NEXUS_PORTAL_API_TOKEN above
#(NexPulse → PrimeNet HTTP, never direct DB).

#Subscriber profile API base URL.
NEXUS_MARKETING_SUBSCRIBER_API=

#Message delivery / campaign API base URL.
NEXUS_MARKETING_DELIVERY_API=
