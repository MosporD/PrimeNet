# Default: SQLite (*.db files in the project root).
DB_ENGINE=sqlite
DATABASE_URL=

# Optional — PostgreSQL (`docker compose up -d` first):
# DB_ENGINE=postgresql
# DATABASE_URL=postgresql://primenet:primenet@localhost:5432/primenet

# ── PM hourly ingest (Nokia + Huawei) ─────────────────────────────────────
# full (default) = delete all rows in each RAT table before each scheduled ingest.
# incremental = keep existing rows; only upsert (cell_name + timestamp). Better for 2-hourly pulls.
# PM_SYNC_MODE=incremental
#
# After ingest, delete PM rows older than N days (default 7; set to 0 to disable).
# PM_RETENTION_DAYS=7
#
# SQLite batch size for INSERT OR REPLACE (optional tuning).
# PM_INSERT_BATCH_SIZE=2500
