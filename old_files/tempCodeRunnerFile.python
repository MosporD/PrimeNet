"""
Database Migration - Add Missing Columns & Roles
Fixes:
1. Adds xml_file_path to tasks table
2. Adds xml_file_name to tasks table  
3. Updates user roles to include 'config_team'
"""

import sqlite3
import os
import glob
import sys

def find_database():
    """Search for database file"""
    search_patterns = [
        'ncm_users.db',
        '../ncm_users.db',
        'instance/ncm_users.db',
        '*/ncm_users.db',
        '*/*/ncm_users.db',
    ]
    
    for pattern in search_patterns:
        matches = glob.glob(pattern)
        if matches:
            return os.path.abspath(matches[0])
    
    return None

def fix_database(database_path):
    """Add missing columns and update schema"""
    
    print(f"✓ Using database: {database_path}")
    
    conn = sqlite3.connect(database_path)
    cursor = conn.cursor()
    
    # Check which tables exist
    cursor.execute("SELECT name FROM sqlite_master WHERE type='table'")
    existing_tables = [row[0] for row in cursor.fetchall()]
    print(f"\n📋 Existing tables: {', '.join(existing_tables)}")
    
    changes_made = 0
    
    # ========================================================================
    # FIX 1: Add xml_file_path and xml_file_name to tasks table
    # ========================================================================
    if 'tasks' in existing_tables:
        print("\n🔧 Checking tasks table schema...")
        
        # Get current columns
        cursor.execute("PRAGMA table_info(tasks)")
        columns = [row[1] for row in cursor.fetchall()]
        print(f"   Current columns: {', '.join(columns)}")
        
        # Add xml_file_path if missing
        if 'xml_file_path' not in columns:
            print("\n   ➕ Adding xml_file_path column...")
            cursor.execute("ALTER TABLE tasks ADD COLUMN xml_file_path TEXT")
            changes_made += 1
            print("      ✓ Added xml_file_path")
        else:
            print("   ⏭️  xml_file_path already exists")
        
        # Add xml_file_name if missing
        if 'xml_file_name' not in columns:
            print("\n   ➕ Adding xml_file_name column...")
            cursor.execute("ALTER TABLE tasks ADD COLUMN xml_file_name TEXT")
            changes_made += 1
            print("      ✓ Added xml_file_name")
        else:
            print("   ⏭️  xml_file_name already exists")
    else:
        print("\n❌ tasks table doesn't exist! Run add_new_tables_v2.py first")
    
    # ========================================================================
    # FIX 2: Check user roles
    # ========================================================================
    print("\n🔧 Checking user roles...")
    cursor.execute("SELECT username, role FROM users")
    users = cursor.fetchall()
    
    if users:
        print(f"\n   Current users:")
        for username, role in users:
            print(f"      - {username}: {role}")
        
        print("\n   💡 Available roles:")
        print("      - admin: Full access to everything")
        print("      - config_team: Can create/edit configurations")
        print("      - user: Basic access (view only)")
    
    # Commit changes
    conn.commit()
    conn.close()
    
    print("\n" + "="*60)
    print(f"✅ Database Fixed!")
    print(f"   Changes made: {changes_made}")
    print("="*60)
    
    return True

if __name__ == '__main__':
    print("="*60)
    print("NCM Database Fix - Add Missing Columns")
    print("="*60)
    
    # Try to find database
    print("\n🔍 Searching for database...")
    database_path = find_database()
    
    if not database_path:
        print("\n❌ Could not find ncm_users.db!")
        user_input = input("\nEnter database path (or press Enter to exit): ").strip()
        
        if user_input and os.path.exists(user_input):
            database_path = user_input
        else:
            print("\n❌ Database not found. Exiting...")
            input("\nPress Enter to exit...")
            sys.exit(1)
    
    print(f"\n✓ Found database!")
    
    try:
        success = fix_database(database_path)
        
        if success:
            print("\n🎉 Database fixed successfully!")
            print("\n📝 Next steps:")
            print("   1. Update backend files (app.py, database.py)")
            print("   2. Update frontend files (index.html, app.js)")
            print("   3. Restart Flask server")
            print("   4. Test creating tasks with XML files")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()
    
    input("\nPress Enter to exit...")