  "narrative": {
    "northStar": "The Ops Constellation",
    "overview": "NexusCore\u2019s visual world is a dual-register operator platform. At the gate \u2014 login and the portal tower \u2014 the experience is cinematic: deep navy fields, constellation/radar atmosphere, soft cyan instrument light, and glass panels that feel like entering a control constellation. Once inside PrimeNet (and sibling portals\u2019 work surfaces), the register shifts to a soft-steel daylight workbench: cool paper backgrounds, white instrument cards, muted steel accents, and scan-first density for RAN engineers.\n\nPersonality is tactile instrument chrome \u2014 controls should feel pressable and precise, not decorative. Soft lift keeps cards and panels slightly airborne so structure reads quickly without heavy skeuomorphism. The system rejects purple SaaS gradients and neon cyber glow; accent energy stays in Soft Steel Sky and gate cyan only.",
    "keyCharacteristics": [
      "Dual-register: cinematic gate \u2192 utilitarian engineering floors",
      "Soft Steel Sky as the sole primary accent family in work surfaces",
      "Soft-lift cards/panels with cool borders and restrained shadows",
      "System UI type (Segoe stack) for operator familiarity and speed",
      "Light + dark parity required; dark uses slate-navy tonal panels (--dm-*)"
    ],
    "rules": [
      {
        "name": "The Soft Steel Sky Rule",
        "body": "Workbench accent is Soft Steel Sky (and its deep twin). Do not introduce a second brand accent on module pages.",
        "section": "colors"
      },
      {
        "name": "The Gate Cyan Containment Rule",
        "body": "Gate cyan belongs to login/portal-tower atmosphere. Inside Engineering modules, steel + dark-link blue carry interaction \u2014 not neon cyan wash.",
        "section": "colors"
      },
      {
        "name": "The No Purple Nebula Rule",
        "body": "No purple/magenta SaaS gradients, no fuchsia cyber glow rings. If atmosphere needs energy, use steel or gate cyan only.",
        "section": "colors"
      },
      {
        "name": "The One Stack Rule",
        "body": "Stay on the Segoe UI system stack for product chrome. Do not swap in Inter/Roboto/display serifs for \u201cmodern SaaS.\u201d",
        "section": "typography"
